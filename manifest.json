{
  "manifest_version": 3,
  "name": "SmartForm Filler - Dev AI Assistant",
  "short_name": "SmartForm AI",
  "version": "1.1.0",
  "description": "Intelligent browser extension for developers. AI-powered (Ollama/local LLM) or heuristic scanning of forms on dev/staging sites. One-click prefill with realistic AU-focused test data for address, signup, account creation forms etc.",
  "author": "Phil (custom for dev workflow)",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "identity",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "vendor/address-schemas.js",
        "formdata.js",
        "profile-ui.js",
        "ai-field-detector.js",
        "form-registry.js",
        "hotkeys.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SmartForm Filler - Scan & Prefill Forms",
    "default_icon": {
      "16": "icons/icon-idle16.png",
      "32": "icons/icon-idle32.png",
      "48": "icons/icon-idle48.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
